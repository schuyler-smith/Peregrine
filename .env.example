# Copy this file to .env and fill it in. Keep .env private.

# Password for the planner (your browser asks for it; any username works).
PEREGRINE_PASSWORD=pick-a-long-password

# The name(s) or IP you'll type in the browser to reach the server, comma-separated.
# Example: birds.example.com,192.168.1.50
PEREGRINE_ALLOWED_HOSTS=localhost

# Optional: your eBird API key (or paste it in the planner's Settings instead).
EBIRD_API_KEY=
