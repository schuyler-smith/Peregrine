# Everything here is optional. Copy this file to .env and fill in what you want.

# Your eBird API key (or paste it in Peregrine's Settings instead).
EBIRD_API_KEY=

# Ask for a password before showing Peregrine (any username works). Blank = no password.
PEREGRINE_PASSWORD=

# Only answer to these addresses, comma-separated (e.g. birds.example.com,192.168.1.50).
# Blank = any address.
PEREGRINE_ALLOWED_HOSTS=
